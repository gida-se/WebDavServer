<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="15.0">
    <PropertyGroup>
        <Description>ASP.NET Core integration for the .NET WebDAV server</Description>
        <TargetFramework>net9.0</TargetFramework>
        <NoWarn>CS8602;CS8632</NoWarn>

        <!-- For nuget -->
        <Version>1.0.1</Version>
        <PackageId>Gida.FubarDev.WebDavServer.AspNetCore</PackageId>
        <IncludeSymbols>true</IncludeSymbols>
        <IncludeSource>true</IncludeSource>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeReferencedProjects>true</IncludeReferencedProjects>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FubarDev.WebDavServer\FubarDev.WebDavServer.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Scrutor" Version="5.0.2"/>
    </ItemGroup>
</Project>