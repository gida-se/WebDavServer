<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="15.0">
    <PropertyGroup>
        <Description>A .NET WebDAV server</Description>
        <TargetFramework>netstandard2.1</TargetFramework>
        <NoWarn>CS8602;CS8603;CS8632;SA1633;SA1028;SA1516;SA1507;SA1512;SA1614;SA1201;SA1401;SA1601;SA1310;SA1402;SA1649;SA1508;CS8767;CS1574;SA1202;SA1618;SA1137;SA1120</NoWarn>
    </PropertyGroup>
    <!--    <Import Project="../../PackageLibrary.props"/>-->

    <Import Project="../../../../Prod/Directory.Packages.props"/>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Options"/>
        <PackageReference Include="System.Buffers"/>
        <PackageReference Include="System.Collections.Immutable"/>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Utils\UAParser\UAParser.regexes.yaml"/>
        <None Include="Model\webdav.xsd"/>
    </ItemGroup>
    <ItemGroup>
        <Compile Update="Model\webdav.cs">
            <DependentUpon>webdav.xsd</DependentUpon>
        </Compile>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>
</Project>